---
/** Home service card (spec §5.2). The whole card is clickable via a stretched link. */
import Eyebrow from './Eyebrow.astro';
import { serviceHref, type Service } from '../content/services';
interface Props { service: Service }
const { service } = Astro.props;
---
<article class="service-card" data-reveal>
  <Eyebrow class="mb-0">{service.number}</Eyebrow>
  <h3 class="h3">{service.title}</h3>
  <p class="text-ink-2">{service.card}</p>
  <a href={serviceHref(service)} class="learn-more">Learn more <span aria-hidden="true">→</span></a>
</article>

<style>
  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 32px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    transition: border-color 150ms ease-out;
  }
  @media (max-width: 767.98px) {
    .service-card {
      padding: 24px;
    }
  }
  .service-card:hover,
  .service-card:focus-within {
    border-color: var(--accent);
  }
  .learn-more {
    margin-top: auto;
    font: 500 16px/24px var(--font-body);
    color: var(--accent);
    text-decoration: none;
  }
  .learn-more::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .service-card:hover .learn-more {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .learn-more:focus-visible {
    outline: none;
  }
  .service-card:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>

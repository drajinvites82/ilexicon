---
/** Site footer (spec §4.2). Privacy link is hidden until the page exists (spec §11). */
import Logo from './Logo.astro';
import OfficeBlock from './OfficeBlock.astro';
import { site, navLinks } from '../content/site';
const year = new Date().getFullYear();
---
<footer class="border-t border-line">
  <div class="container-site pt-16 pb-8">
    <div class="small grid gap-10 md:grid-cols-12 md:gap-6">
      <div class="md:col-span-5">
        <a href="/" aria-label="iLexicon home" class="inline-flex">
          <Logo height={40} />
        </a>
        <p class="mt-4 font-display text-[16px] leading-6 font-medium text-ink">{site.tagline}</p>
        <p class="mt-2 max-w-[32ch] text-ink-2">{site.footerDescription}</p>
      </div>

      <nav aria-label="Footer" class="md:col-span-3">
        <ul class="m-0 flex list-none flex-col gap-2 p-0">
          {navLinks.map((l) => (
            <li><a href={l.href} class="text-ink-2 transition-colors hover:text-ink">{l.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="md:col-span-4">
        <OfficeBlock />
      </div>
    </div>

    <div class="small mt-10 flex flex-wrap justify-between gap-3 border-t border-line pt-6 text-ink-3 md:mt-16">
      <span>© {year} {site.legalEntity}</span>
      {site.privacy.show && (
        <a href={site.privacy.href} class="text-ink-3 transition-colors hover:text-ink">Privacy</a>
      )}
    </div>
  </div>
</footer>

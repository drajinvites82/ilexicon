---
/** The one office block on the site (spec §4.2, §8.2): label, address, tel: link, ideas@ link. */
import { site } from '../content/site';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
const { office, phone, emails } = site;
---
<address class:list={['not-italic', cls]}>
  <p class="font-medium text-ink">{office.label}</p>
  <p>{office.street}<br />{office.city}, {office.region} {office.postalCode}</p>
  <p class="mt-2">
    <a href={`tel:${phone.tel}`} class="text-inherit hover:text-ink">{phone.display}</a><br />
    <a href={`mailto:${emails.ideas}`} class="text-accent underline underline-offset-2 hover:text-accent-hover">{emails.ideas}</a>
  </p>
</address>
